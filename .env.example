DISCORD_TOKEN=put-your-bot-token-here
PREFIX=!

# Verify API (the Roblox check running on this same Pi)
BDX_VERIFY_URL=http://localhost:8080
# The API_KEY from ~/Verify/.env
BDX_VERIFY_KEY=
# Role !verify gives when someone passes
BDX_VERIFIED_ROLE_ID=
# Channel where join checks and !verify results get posted for staff.
# Leave empty to use the server's system channel for joins.
BDX_VERIFY_LOG_CHANNEL=

# Web panel for editing commands and settings from a browser or phone.
# Pick a long password. Leave it empty to turn the panel off.
PANEL_PASSWORD=
PANEL_PORT=3200

# RoVuew (commands/rovuew.bdx): inventory checks against your flag list.
# Where the flag list and custom keywords are kept. Copy RoVuew's old data folder here.
ROVUEW_DATA_DIR=data/rovuew
# Open Cloud key with Inventory read access, needed for badge scans
ROBLOX_API_KEY=
SERVERSWEEP_API_KEY=
XTRACKER_API_KEY=
# Who can use /flag add, /autoflag and /searchcatalog besides Manage Server
ROVUEW_ADMIN_ROLE_ID=
# Comma separated Discord user IDs
ROVUEW_ACCEPTED_USERS=
# RoVuew's HTTP API, which Verify calls. Comma separated keys. Empty turns the API off.
ROVUEW_API_KEYS=
ROVUEW_API_PORT=3001

# AESU shift tracker (commands/aesu). The panel's Shifts page fills all of this in
# from the old tracker's .env. Any setting below can also be written with an AESU_
# name, which wins, for when BDX already uses the plain name for something else.
AESU_ENABLED=no
# The old tracker's Postgres, so every link, shift and event carries over
DATABASE_URL=
# /connect asks Bloxlink who somebody is. Left empty, these are read from Verify's .env.
# Without Bloxlink, people type their username and prove it with a code in their Roblox About.
BLOXLINK_KEY=
BLOXLINK_GUILD_ID=
# The old OAuth web page, and /health. Same port as before.
AESU_PORT=3000
PUBLIC_BASE_URL=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
# .ROBLOSECURITY of a throwaway account, for reading who is in game. Never your main.
ROBLOX_COOKIE=
TRACKED_UNIVERSE_IDS=
TRACKED_PLACE_IDS=
SHIFT_PROMPT_CHANNEL_ID=
SHIFT_LOG_CHANNEL_ID=
SHIFT_STAFF_ROLE_ID=
EVENT_CHANNEL_ID=
ADMIN_ROLE_ID=
# The Roblox group, and a cookie for an account that can rank people in it
ROBLOX_GROUP_ID=
ROBLOX_GROUP_COOKIE=
GROUP_STAFF_ROLE_ID=
GROUP_LOG_CHANNEL_ID=
PROMOTION_CHANNEL_ID=
PROMOTION_STAFF_ROLE_ID=
# Google Sheets for the rank ladder and the application form
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
APPLICATION_SHEET_ID=
APPLICATION_CHANNEL_ID=
APPLICATION_FORM_URL=
