@name promote
@type slash
@description promotions
@option action:string:what u wanna do:required:request=Request|check=Check|ranks=Ranks|sync=Sync
@option user:user:whose progress
$c[Runs the snippet for the action picked, like promote_request. Each one is below.]
$include[promote_$message[action]]
---
@name promote_request
@type snippet
$c[/promote action:request. Ask to be promoted.]
$ephemeral
$var[r;$promoRequest]
$if[$var[r]==promoted]
promoted to $json[rankName] in the group, do /verify again in #verification
$elseif[$var[r]==needs_approval]
$if[$json[posted]==yes]
u got everything for $json[rankName], request sent, wait for HC
$else
u got everything for $json[rankName] but some dumbass deleted the promotion req channel, tell staff to check `PROMOTION_CHANNEL_ID`
$endif
$elseif[$var[r]==not_ready]
not yet, grind more $json[missing]
$include[promocard]
$elseif[$var[r]==manual]
$json[rankName] is manual approval only
$elseif[$var[r]==unconfigured]
reqs for $json[rankName] still WiP, soon
$elseif[$var[r]==top]
wow u found a weird thing here
$else
$json[error]
$endif
---
@name promote_check
@type snippet
$c[/promote action:check. What the next rank up needs.]
$c[Public, so it can be shown to whoever is asking about it.]
$var[r;$promoCheck[$message[user]]]
$if[$var[r]!=ok]
$ephemeral
$stop[$json[error]]
$endif
$include[promocard]
---
@name promote_ranks
@type snippet
$c[/promote action:ranks. Every rank and what it asks for.]
$ephemeral
$promoRanks
$if[$json[stored]==0]
$stop[$if[$json[group]==yes;no ranks loaded yet, run `/promote action:sync`;promotions off, set `ROBLOX_GROUP_ID` n `ROBLOX_GROUP_COOKIE` then restart]]
$endif
$onlyIf[$json[count]>0;group got no ranks between guest n owner, nothing to promote into]
$addContainer[ranks]
$addTextDisplay[$jsonList[ranks;`{number}` {name} ({modeLabel}{memberText})
{requirements|_nothing yet_};;\n\n]]
$addSeparator
$addTextDisplay[$if[$json[sheets]==yes;edit these in the Ranks tab;google sheets not set up so cant edit these yet]]
$closeContainer
---
@name promote_sync
@type snippet
$c[/promote action:sync. Sync with new updates]
$ephemeral
$onlyIf[$aesuAllowed[promotion]==yes;$if[$aesuRole[promotion]==;u cant do that;only $aesuRole[promotion] can do that]]
$var[r;$promoSync]
$onlyIf[$var[r]==ok;$json[error]]
$if[$json[sheets]==yes]
synced $json[ranks] ranks w the sheet
$if[$json[problemCount]>0]

couldnt read $json[problemCount] reqs:
$jsonList[problems;• {@}]
$endif
$else
got $json[ranks] ranks from the group, set `GOOGLE_SHEET_ID` to write reqs
$endif
---
@name promocard
@type snippet
$c[The promotion check, from $promoCheck's JSON: one bar per requirement of the next rank up.]
$addContainer[promotion]
$addSection[### $if[$json[atTop]==yes;promotions;next up: $json[nextName]]
rn: $json[currentName]$if[$json[squad]!=; · $json[squad]]$if[$json[robloxUsername]!=; · `$json[robloxUsername]`]
$if[$json[atTop]==yes;this is error message too but idk why so blame malleggc;$if[$json[unconfigured]==yes;so this is error message, blame rammingt;$if[$json[ready]==yes;ready, do `/promote action:request`;$json[percent]% there]]];$userAvatar[$json[discordId]]]
$if[$json[requirementCount]>0]
$addSeparator
$addTextDisplay[$jsonList[requirements;{icon} {label}
`{bar}` {amount};;\n\n]]
$endif
$if[$json[hiddenCount]>0]
$addTextDisplay[+ $json[hiddenCount] more]
$endif
$if[$json[next;generalCount]>0]
$addSeparator
$addTextDisplay[also needed
$json[next;generalList]]
$endif
$addTextDisplay[-# all time shifts$if[$json[hostedEvents]>0; · $json[hostedEvents] events hosted]]
$closeContainer
---
@name promotion request
@type hook
$c[Posted in PROMOTION_CHANNEL_ID for a rank set to approval. Redrawn with decided = yes once staff press a button.]
$if[$json[decided]==no]
$json[staffRole]
$endif
$addContainer[request]
$addTextDisplay[### promo to $json[rankName]
<@$json[discordId]> got everything for $json[rankName], rn $json[currentName]]
$addSeparator
$addTextDisplay[reqs
$jsonList[requirements;{mark} {description}]]
$if[$json[next;generalCount]>0]
$addTextDisplay[check these first
$json[next;generalList]]
$endif
$if[$json[decided]==yes]
$addSeparator
$addTextDisplay[$if[$json[approved]==yes;approved;denied] by <@$json[decidedBy]>
$json[note]]
$else
$addButton[yes;aesu:promote_ok:$json[discordId]:$json[roleId];Approve;success]
$addButton[no;aesu:promote_no:$json[discordId]:$json[roleId];Deny;danger]
$endif
$addTextDisplay[-# approve = rank in the group, rover does discord roles]
$closeContainer
$include[promocard]
---
@name aesu:promote_ok
@type button
$ephemeral
$var[r;$promoDecide[approve;$message[1];$message[2]]]
$onlyIf[$var[r]==ok;$json[error]]
<@$json[discordId]> is $json[rankName] now, discord roles update when rover catches up
---
@name aesu:promote_no
@type button
$ephemeral
$var[r;$promoDecide[deny;$message[1];$message[2]]]
$onlyIf[$var[r]==ok;$json[error]]
denied <@$json[discordId]> promo
