@name groupgate
@type snippet
$c[Checked first by every /group command: the staff role, and a group to act on.]
$ephemeral
$onlyIf[$aesuAllowed[group]==yes;$if[$aesuRole[group]==;u cant do that;only $aesuRole[group] can manage the group]]
$onlyIf[$groupOn==yes;group stuff is off, set `ROBLOX_GROUP_ID` n `ROBLOX_GROUP_COOKIE` (acc that can rank) then restart]
---
@name group
@type slash
@description roblox group
@option action:string:what u wanna do:required:pending=Pending|accept=Accept|decline=Decline|rank=Rank|promote=Promote|demote=Demote|exile=Exile|info=Info|roles=Roles
@option player:string:roblox username or id or a discord ping
@option role:string:rank name or number
$c[Runs the snippet for the action picked, like group_pending. Each one is below.]
$include[group_$message[action]]
---
@name group_pending
@type snippet
$c[/group action:pending. Everybody waiting to join the group.]
$include[groupgate]
$var[r;$groupPending]
$onlyIf[$var[r]==ok;$json[error]]
$onlyIf[$json[count]>0;no join requests rn]
$addContainer[pending]
$addTextDisplay[$json[count] waiting
$jsonList[requests;{profile} {when}]]
$addTextDisplay[-# `/group action:accept` to let someone in]
$closeContainer
---
@name group_accept
@type snippet
$c[/group action:accept. Accept somebody into the group.]
$onlyIf[$message[player]!=;fill in player for /group action:accept]
$include[groupgate]
$var[r;$groupDecide[accept;$message[player]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[user] accepted
---
@name group_decline
@type snippet
$c[/group action:decline. Turn down somebody's request to join.]
$onlyIf[$message[player]!=;fill in player for /group action:decline]
$include[groupgate]
$var[r;$groupDecide[decline;$message[player]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[user] declined
---
@name group_rank
@type snippet
$c[/group action:rank. Set somebody to an exact rank.]
$onlyIf[$message[player]!=;fill in player for /group action:rank]
$onlyIf[$message[role]!=;fill in role for /group action:rank]
$include[groupgate]
$var[r;$groupRank[$message[player];$message[role]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[user] is $json[role;label] now
---
@name group_promote
@type snippet
$c[/group action:promote. Move somebody one rank up.]
$onlyIf[$message[player]!=;fill in player for /group action:promote]
$include[groupgate]
$var[r;$groupStep[up;$message[player]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[user] is $json[role;label] now
---
@name group_demote
@type snippet
$c[/group action:demote. Move somebody one rank down.]
$onlyIf[$message[player]!=;fill in player for /group action:demote]
$include[groupgate]
$var[r;$groupStep[down;$message[player]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[user] is $json[role;label] now
---
@name group_exile
@type snippet
$c[/group action:exile. Remove somebody from the group.]
$onlyIf[$message[player]!=;fill in player for /group action:exile]
$include[groupgate]
$var[r;$groupExile[$message[player]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[user] exiled, was $json[was;label]
---
@name group_info
@type snippet
$c[/group action:info. Somebody's rank and whether they are waiting to join.]
$onlyIf[$message[player]!=;fill in player for /group action:info]
$include[groupgate]
$var[r;$groupInfo[$message[player]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[user] · `$json[robloxId]`
$if[$json[inGroup]==yes;in group as $json[role;label];not in the group]
$if[$json[waiting]==yes]
got a join request waiting
$endif
$if[$json[linked]==no]
no discord linked
$endif
---
@name group_roles
@type snippet
$c[/group action:roles. The rank ladder and how many hold each one.]
$include[groupgate]
$var[r;$groupRoles]
$onlyIf[$var[r]==ok;$json[error]]
$onlyIf[$json[count]>0;group got no ranks, prob wrong id]
$addContainer[roles]
$addTextDisplay[$jsonList[roles;`{number}` {name}{members}{note}]]
$closeContainer
---
@name group log
@type hook
$c[Written to GROUP_LOG_CHANNEL_ID for every group action, when that is set.]
$addContainer[log]
$addTextDisplay[$json[action] · $json[user]
$if[$json[detail]!=;$json[detail]
]by <@$json[actorId]> · <t:$getTimestamp:f>]
$closeContainer
