@name diagnose
@type slash
@description why the bot cant see u in game
$ephemeral
$aesuDiagnose
$addContainer[diagnose]
$addTextDisplay[### diagnose]
$addTextDisplay[$jsonList[sections;{title} {mark}
{text};;\n\n]]
$if[$json[verdict]!=]
$addSeparator
$addTextDisplay[$json[verdict;mark] $json[verdict;text]]
$endif
$closeContainer
