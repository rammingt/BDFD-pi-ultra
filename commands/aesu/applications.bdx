@name appgate
@type snippet
$c[Applications hold what people wrote about themselves, so the role that decides them decides who reads them.]
$ephemeral
$onlyIf[$aesuAllowed[group]==yes;$if[$aesuRole[group]==;u cant do that;only $aesuRole[group] can read apps]]
---
@name applications
@type slash
@description applications
@option action:string:what u wanna do:required:list=List|post=Post
@option search:string:search answers
@option page:integer:page
@option number:integer:app number from the list
@option to:integer:post up to this number
$c[Runs the snippet for the action picked, like applications_list. Each one is below.]
$include[applications_$message[action]]
---
@name applications_list
@type snippet
$c[/applications action:list. Every application in the form, newest first.]
$include[appgate]
$var[r;$appList[$message[search];$message[page]]]
$onlyIf[$var[r]==ok;$json[error]]
$include[applist]
---
@name aesu:app_page
@type button
$c[Previous and Next on the list. $message[1] is the page counted from 0, and the rest is the search.]
$include[appgate]
$updateMessage
$var[search;$replaceText[$customID;aesu:app_page:$message[1]:;;1]]
$var[r;$appList[$var[search];$sum[$message[1];1]]]
$onlyIf[$var[r]==ok;$json[error]]
$include[applist]
---
@name applist
@type snippet
$c[One page of the list, from $appList's JSON.]
$addContainer[list]
$addTextDisplay[### $if[$json[search]==;apps;apps w "$json[search]"]]
$if[$json[total]==0]
$addTextDisplay[$if[$json[search]==;responses tab is empty, check `APPLICATION_TAB` is the right tab name;nothing matches, search only looks at answers]]
$else
$addTextDisplay[$jsonList[applications;{line}{unseen}]]
$addTextDisplay[-# $json[from] to $json[to] of $json[total]$if[$json[pages]>1; · page $json[page]/$json[pages]] · /applications action:post to post one]
$if[$json[pages]>1]
$addButton[yes;aesu:app_page:$json[previous]:$json[search];Previous;secondary;$json[atStart]]
$addButton[no;aesu:app_page:$json[next]:$json[search];Next;secondary;$json[atEnd]]
$endif
$endif
$closeContainer
---
@name applications_post
@type snippet
$c[/applications action:post. Put an application in the applications channel, with Accept and Deny buttons.]
$onlyIf[$message[number]!=;fill in number for /applications action:post]
$include[appgate]
$var[r;$appPost[$message[number];$message[to]]]
$if[$var[r]==partial]
$stop[only posted $json[sent] of $json[wanted], check the bot can talk in <#$json[channelId]>]
$endif
$onlyIf[$var[r]==ok;$json[error]]
posted $json[sent] in <#$json[channelId]>$if[$json[title]!=;: $json[title]]
---
@name application
@type hook
$c[A new application in APPLICATION_CHANNEL_ID. Redrawn with decided = yes once somebody accepts or denies it.]
$addContainer[card]
$addTextDisplay[### $json[title]$if[$json[lead]!=;
$json[lead]]]
$addSeparator
$addTextDisplay[$jsonList[answers;{question}
{answer};;\n\n]]
$if[$json[hiddenCount]>0]
$addTextDisplay[+ $json[hiddenCount] more answers in the sheet]
$endif
$if[$json[decided]==yes]
$addSeparator
$addTextDisplay[$if[$json[accepted]==yes;accepted;denied] by <@$json[decidedBy]>$if[$json[reason]!=;
$json[reason]]$if[$json[note]!=;
$json[note]]]
$else
$addButton[yes;aesu:app_accept:$json[args];Accept;success]
$addButton[no;aesu:app_deny:$json[args];Deny;danger]
$if[$json[canCheck]==yes]
$addButton[no;aesu:app_check:$json[args];Background check;secondary]
$endif
$endif
$addTextDisplay[-# app #$json[row]$if[$json[submitted]!=; · $json[submitted]]]
$closeContainer
---
@name aesu:app_accept
@type button
$c[Opens the reason form. Checked here, because a form has to be the first answer.]
$include[appgate]
$var[r;$appCard]
$onlyIf[$var[r]==ok;$json[error]]
$showModal[aesu:app_accept:$message[1]:$message[2]:$message[3];Accept]
$addTextInput[reason;Reason (optional);paragraph;no;anything u want them to know, or leave it empty;;;500]
---
@name aesu:app_deny
@type button
$include[appgate]
$var[r;$appCard]
$onlyIf[$var[r]==ok;$json[error]]
$showModal[aesu:app_deny:$message[1]:$message[2]:$message[3];Deny]
$addTextInput[reason;Why;paragraph;yes;they get sent this so write it for them;;;500]
---
@name aesu:app_accept
@type modal
$c[The reason form coming back. Acts on the group, redraws the card and tells the applicant.]
$include[appgate]
$var[r;$appDecide[accept;$message[1];$message[2];$message[3];$input[reason]]]
$onlyIf[$var[r]==ok;$json[error]]
accepted, $json[note], $json[dmNote]
---
@name aesu:app_deny
@type modal
$include[appgate]
$var[r;$appDecide[deny;$message[1];$message[2];$message[3];$input[reason]]]
$onlyIf[$var[r]==ok;$json[error]]
denied, $json[note], $json[dmNote]
---
@name application decision
@type hook
$c[DMed to the applicant. Says nothing about Roblox, since whether a join request was waiting is not known here.]
$addContainer[decision]
$if[$json[accepted]==yes]
$addTextDisplay[### ur app got accepted
welcome$if[$json[guildName]!=; to $json[guildName]]]
$else
$addTextDisplay[### ur app got denied
thx for applying$if[$json[guildName]!=; to $json[guildName]] but its a no this time]
$endif
$if[$json[reason]!=]
$addTextDisplay[why
$json[reason]]
$endif
$if[$json[accepted]==no]
$if[$json[formUrl]!=]
$addTextDisplay[apply again here
$json[formUrl]]
$endif
$endif
$closeContainer
---
@name aesu:app_check
@type button
$c[Runs the applicant through RoVuew. Private to whoever asked: it is somebody's record, and the channel may not be staff only.]
$ephemeral
$onlyIf[$aesuAllowed[group]==yes;u cant run checks]
$var[r;$appCheck[$message[2];$message[3]]]
$onlyIf[$var[r]==ok;$json[error]]
$addContainer[check]
$addTextDisplay[### bg check: $json[username]
$if[$json[flagged]==yes;found something, read it first;$if[$json[incomplete]==yes;nothing found but some checks didnt answer, kinda clear;all clear]]]
$if[$json[private]==yes]
$addTextDisplay[inventory private
couldnt see items, only the rep checks ran]
$endif
$if[$jsonCount[sections]>0]
$addSeparator
$addTextDisplay[$jsonList[sections;{title}
{lines};;\n\n]]
$endif
$if[$json[reputation]!=]
$addSeparator
$addTextDisplay[rep
$json[reputation]]
$endif
$if[$json[appeals]!=]
$addTextDisplay[appeals
$json[appeals]]
$endif
$addTextDisplay[-# roblox $json[userId]$if[$json[discordId]!=; · discord $json[discordId]; · no discord id so discord checks got skipped]$if[$json[score]!=; · score $json[score]]]
$closeContainer
$addButton[yes;$json[profile];Roblox profile;link]
