@name squad
@type slash
@description squads
@option action:string:what u wanna do:required:info=Info|set=Set|clear=Clear|roster=Roster
@option user:user:who
@option squad:string:which squad::from squads
$c[Runs the snippet for the action picked, like squad_info. Each one is below.]
$include[squad_$message[action]]
---
@name squad_info
@type snippet
$c[/squad action:info. Somebody's squad and how many events they have hosted. Defaults to you.]
$ephemeral
$var[r;$squadInfo[$message[user]]]
$if[$json[inSquad]==yes]
<@$json[discordId]> in $json[squad;label] ($json[squad;roles])
$else
<@$json[discordId]> got no squad
$endif
events hosted: $json[hosted]$if[$json[hostedLive]>0; ($json[hostedLive] going rn)]
---
@name squad_set
@type snippet
$c[/squad action:set. Move somebody into a squad. Their old squad role is taken off.]
$onlyIf[$message[user]!=;fill in user for /squad action:set]
$onlyIf[$message[squad]!=;fill in squad for /squad action:set]
$ephemeral
$onlyIf[$aesuAllowed[squad]==yes;$if[$aesuRole[squad]==;u cant do that;only $aesuRole[squad] can change squads]]
$var[r;$squadSet[$message[user];$message[squad]]]
$onlyIf[$var[r]==ok;$json[error]]
<@$json[discordId]> moved to $json[squad;label] ($json[squad;roles])
---
@name squad_clear
@type snippet
$c[/squad action:clear. Take somebody out of their squad.]
$onlyIf[$message[user]!=;fill in user for /squad action:clear]
$ephemeral
$onlyIf[$aesuAllowed[squad]==yes;$if[$aesuRole[squad]==;u cant do that;only $aesuRole[squad] can change squads]]
$var[r;$squadClear[$message[user]]]
$onlyIf[$var[r]==ok;$json[error]]
$if[$json[was]!=]
<@$json[discordId]> taken out of $json[was]
$else
<@$json[discordId]> wasnt in a squad, cleared any leftover roles anyway
$endif
---
@name squad_roster
@type snippet
$c[/squad action:roster. How many people are in each squad.]
$ephemeral
$var[r;$squadRoster]
$onlyIf[$var[r]==ok;$json[error]]
$addContainer[roster]
$addTextDisplay[$jsonList[squads;{role} · {count}]]
$addSeparator
$addTextDisplay[no squad: $json[unassigned]]
$closeContainer
