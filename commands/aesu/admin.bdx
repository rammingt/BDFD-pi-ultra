@name admin
@type slash
@description End shifts and events, and correct banked time.
@option action:string:What to do.:required:panel=Panel|endshift=End shift|endevent=End event|addtime=Add time|removetime=Remove time
@option user:user:Whose shift to end.
@option event:string:Event id, from /event action:list.
@option type:string:Which shift type it counts as.::from shiftTypes
@option time:string:How much. 90m, 2h, 1h30m.
$c[Runs the snippet for the action picked, like admin_panel. Each one is below.]
$include[admin_$message[action]]
---
@name admin_panel
@type snippet
$c[/admin action:panel. Who is on shift, what is running, and the controls for both.]
$ephemeral
$var[r;$adminPanel]
$onlyIf[$var[r]==ok;$json[error]]
$include[adminpanel]
---
@name adminpanel
@type snippet
$c[The admin panel, from $adminPanel's JSON. Shared by the command, the menus and Refresh.]
$addContainer[admin]
$addTextDisplay[### Administrator panel]
$addTextDisplay[On shift ($json[shiftCount])
$if[$json[shiftCount]==0;Nobody is on shift.;$jsonList[shifts;{mention} · {typeLabel}, {worked}{onBreak}]]]
$addTextDisplay[Events ($json[eventCount])
$if[$json[eventCount]==0;No events scheduled or running.;$jsonList[events;{name} · {when}, hosted by {host}]]]
$if[$json[shiftCount]>0]
$addSelectMenu[aesu:admin_end_shift;End somebody's shift]
$addSelectOptions[shifts;{label};{discordId};{description}]
$endif
$if[$json[eventCount]>0]
$addSelectMenu[aesu:admin_end_event;End an event and bank its attendance]
$addSelectOptions[events;{name};{id};{description}]
$endif
$addButton[yes;aesu:admin_refresh;Refresh;secondary]
$addTextDisplay[-# Only you can see this. /admin action:addtime and /admin action:removetime correct banked hours.]
$closeContainer
---
@name aesu:admin_refresh
@type button
$updateMessage
$var[r;$adminPanel]
$onlyIf[$var[r]==ok;$json[error]]
$include[adminpanel]
---
@name aesu:admin_end_shift
@type select
$c[Ends the picked shift, then redraws the panel so that row is gone. The outcome shows above it.]
$updateMessage
$var[r;$adminEndShift[$selectedValues]]
$if[$var[r]==denied]
$stop[$json[error]]
$endif
$var[outcome;$if[$var[r]==ok;Ended <@$json[discordId]>'s shift, $json[banked] banked.;$json[error]]]
$var[r;$adminPanel]
$var[outcome]
$include[adminpanel]
---
@name aesu:admin_end_event
@type select
$updateMessage
$var[r;$adminEndEvent[$selectedValues]]
$if[$var[r]==denied]
$stop[$json[error]]
$endif
$var[outcome;$if[$var[r]==ok;Ended the event $json[name], $json[banked] logged.;$json[error]]]
$var[r;$adminPanel]
$var[outcome]
$include[adminpanel]
---
@name admin_endshift
@type snippet
$c[/admin action:endshift. End somebody's shift for them. The time so far is banked.]
$onlyIf[$message[user]!=;Fill in the user option for /admin action:endshift.]
$ephemeral
$var[r;$adminEndShift[$message[user]]]
$if[$var[r]==notonshift]
$stop[<@$message[user]> is not on shift.]
$endif
$onlyIf[$var[r]==ok;$json[error]]
Ended <@$json[discordId]>'s $json[typeLabel]. $json[banked] banked.
---
@name admin_endevent
@type snippet
$c[/admin action:endevent. End an event now and bank everybody's attendance.]
$onlyIf[$message[event]!=;Fill in the event option for /admin action:endevent.]
$ephemeral
$var[r;$adminEndEvent[$message[event]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[name] is closed. $json[banked] attendee(s) had their time logged.
---
@name admin_addtime
@type snippet
$c[/admin action:addtime. Add banked time to somebody, on one shift type.]
$onlyIf[$message[user]!=;Fill in the user option for /admin action:addtime.]
$onlyIf[$message[type]!=;Fill in the type option for /admin action:addtime.]
$onlyIf[$message[time]!=;Fill in the time option for /admin action:addtime.]
$ephemeral
$var[r;$adminAdjust[add;$message[user];$message[type];$message[time]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[signed] of $json[typeLabel] for <@$json[discordId]>. They now have $json[after] of it.
---
@name admin_removetime
@type snippet
$c[/admin action:removetime. Take banked time off somebody, on one shift type.]
$onlyIf[$message[user]!=;Fill in the user option for /admin action:removetime.]
$onlyIf[$message[type]!=;Fill in the type option for /admin action:removetime.]
$onlyIf[$message[time]!=;Fill in the time option for /admin action:removetime.]
$ephemeral
$var[r;$adminAdjust[remove;$message[user];$message[type];$message[time]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[signed] of $json[typeLabel] for <@$json[discordId]>. They now have $json[after] of it.
---
@name admin log
@type hook
$c[Written to ADMIN_LOG_CHANNEL_ID (or the shift log) for everything /admin does.]
$addContainer[log]
$addTextDisplay[$json[what]
By <@$json[actorId]> · <t:$getTimestamp:f>]
$closeContainer
