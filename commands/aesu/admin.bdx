@name admin
@type slash
@description admin stuff
@option action:string:what u wanna do:required:panel=Panel|endshift=End shift|endevent=End event|addtime=Add time|removetime=Remove time
@option user:user:who
@option event:string:event id
@option type:string:shift type::from shiftTypes
@option time:string:how much like 90m or 2h
$c[Runs the snippet for the action picked, like admin_panel. Each one is below.]
$include[admin_$message[action]]
---
@name admin_panel
@type snippet
$c[/admin action:panel. Who is on shift, what is running, and the controls for both.]
$ephemeral
$var[r;$adminPanel]
$onlyIf[$var[r]==ok;$json[error]]
$include[adminpanel]
---
@name adminpanel
@type snippet
$c[The admin panel, from $adminPanel's JSON. Shared by the command, the menus and Refresh.]
$addContainer[admin]
$addTextDisplay[### admin panel]
$addTextDisplay[on shift ($json[shiftCount])
$if[$json[shiftCount]==0;nobody rn;$jsonList[shifts;{mention} · {typeLabel}, {worked}{onBreak}]]]
$addTextDisplay[events ($json[eventCount])
$if[$json[eventCount]==0;none;$jsonList[events;{name} · {when}, host {host}]]]
$if[$json[shiftCount]>0]
$addSelectMenu[aesu:admin_end_shift;end a shift]
$addSelectOptions[shifts;{label};{discordId};{description}]
$endif
$if[$json[eventCount]>0]
$addSelectMenu[aesu:admin_end_event;end an event]
$addSelectOptions[events;{name};{id};{description}]
$endif
$addButton[yes;aesu:admin_refresh;Refresh;secondary]
$addTextDisplay[-# only u see this, use /admin action:addtime or removetime to fix hours]
$closeContainer
---
@name aesu:admin_refresh
@type button
$updateMessage
$var[r;$adminPanel]
$onlyIf[$var[r]==ok;$json[error]]
$include[adminpanel]
---
@name aesu:admin_end_shift
@type select
$c[Ends the picked shift, then redraws the panel so that row is gone. The outcome shows above it.]
$updateMessage
$var[r;$adminEndShift[$selectedValues]]
$if[$var[r]==denied]
$stop[$json[error]]
$endif
$var[outcome;$if[$var[r]==ok;ended <@$json[discordId]> shift, $json[banked] banked;$json[error]]]
$var[r;$adminPanel]
$var[outcome]
$include[adminpanel]
---
@name aesu:admin_end_event
@type select
$updateMessage
$var[r;$adminEndEvent[$selectedValues]]
$if[$var[r]==denied]
$stop[$json[error]]
$endif
$var[outcome;$if[$var[r]==ok;ended $json[name], $json[banked] logged;$json[error]]]
$var[r;$adminPanel]
$var[outcome]
$include[adminpanel]
---
@name admin_endshift
@type snippet
$c[/admin action:endshift. End somebody's shift for them. The time so far is banked.]
$onlyIf[$message[user]!=;fill in user for /admin action:endshift]
$ephemeral
$var[r;$adminEndShift[$message[user]]]
$if[$var[r]==notonshift]
$stop[<@$message[user]> isnt on shift]
$endif
$onlyIf[$var[r]==ok;$json[error]]
ended <@$json[discordId]> $json[typeLabel], $json[banked] banked
---
@name admin_endevent
@type snippet
$c[/admin action:endevent. End an event now and bank everybody's attendance.]
$onlyIf[$message[event]!=;fill in event for /admin action:endevent]
$ephemeral
$var[r;$adminEndEvent[$message[event]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[name] ended, time logged for $json[banked]
---
@name admin_addtime
@type snippet
$c[/admin action:addtime. Add banked time to somebody, on one shift type.]
$onlyIf[$message[user]!=;fill in user for /admin action:addtime]
$onlyIf[$message[type]!=;fill in type for /admin action:addtime]
$onlyIf[$message[time]!=;fill in time for /admin action:addtime]
$ephemeral
$var[r;$adminAdjust[add;$message[user];$message[type];$message[time]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[signed] $json[typeLabel] for <@$json[discordId]>, now at $json[after]
---
@name admin_removetime
@type snippet
$c[/admin action:removetime. Take banked time off somebody, on one shift type.]
$onlyIf[$message[user]!=;fill in user for /admin action:removetime]
$onlyIf[$message[type]!=;fill in type for /admin action:removetime]
$onlyIf[$message[time]!=;fill in time for /admin action:removetime]
$ephemeral
$var[r;$adminAdjust[remove;$message[user];$message[type];$message[time]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[signed] $json[typeLabel] for <@$json[discordId]>, now at $json[after]
---
@name admin log
@type hook
$c[Written to ADMIN_LOG_CHANNEL_ID (or the shift log) for everything /admin does.]
$addContainer[log]
$addTextDisplay[$json[what]
by <@$json[actorId]> · <t:$getTimestamp:f>]
$closeContainer
