@name shift
@type slash
@description shift stuff
@option action:string:what u wanna do:required:manage=Manage|history=History
@option user:user:whose shifts, empty = urs
@option limit:integer:how many (1 to 25)
$c[Runs the snippet for the action picked, like shift_manage. Each one is below.]
$include[shift_$message[action]]
---
@name shift_manage
@type snippet
$c[/shift action:manage. Open the shift panel to start, pause or end a shift.]
$c[The panel is the "shiftpanel" snippet below, shared by every button on it.]
$ephemeral
$shiftPanel
$include[shiftpanel]
$aesuJoinWarning
---
@name shift_history
@type snippet
$c[/shift action:history. List recent shifts.]
$ephemeral
$var[who;$if[$message[user]==;$authorID;$message[user]]]
$shiftHistory[$var[who];$if[$message[limit]==;10;$message[limit]]]
$addContainer[history]
$addSection[### $displayName[$var[who]] recent shifts;$userAvatar[$var[who]]]
$if[$json[count]==0]
$addTextDisplay[no shifts yet]
$else
$addTextDisplay[$jsonList[shifts;{startedDate} · {worked} · {typeLabel}{note}]]
$endif
$closeContainer
$aesuJoinWarning
---
@name checktime
@type slash
@description check shift time
@option user:user:whose time, empty = urs
@option range:string:time range, empty = all time::today=Today|week=Last 7 days|month=Last 30 days|all=All time
@option public:boolean:show it to everyone
$if[$message[public]!=true]
$ephemeral
$endif
$var[who;$if[$message[user]==;$authorID;$message[user]]]
$var[r;$shiftTime[$var[who];$message[range]]]
$onlyIf[$var[r]==ok;$json[error]]
$addContainer[time]
$addSection[### $displayName[$var[who]] shift time
$if[$json[linked]==yes;roblox: $json[roblox];no roblox linked] · $json[rangeLabel];$userAvatar[$var[who]]]
$addSeparator
$addTextDisplay[total: $json[worked] ($json[workedHours])
shifts: $json[shiftCount]
avg: $json[average]
longest: $json[longest]
break time: $json[onBreak]
last shift: $json[lastShift]]
$addSeparator
$addTextDisplay[squad: $json[squad]
events hosted: $json[hostedText]]
$if[$json[byTypeCount]>0]
$addSeparator
$addTextDisplay[per type
$jsonList[byType;{label}: {worked}, {shifts}]]
$endif
$if[$json[open]!=]
$addSeparator
$addTextDisplay[rn: $json[open;statusLabel], $json[open;typeLabel], $json[open;worked] so far (not in the total yet)]
$endif
$closeContainer
$aesuJoinWarning
---
@name shiftpanel
@type snippet
$c[Draws the shift panel from $shiftPanel's JSON. state is none, active or on_break.]
$addContainer[panel]
$if[$json[state]==none]
$addTextDisplay[### shift panel]
$if[$json[selected]!=]
$addTextDisplay[picked $json[selected;label]$if[$json[selected;description]!=;, $json[selected;description]]
hit start when ur ready]
$else
$addTextDisplay[pick ur shift type below then hit start]
$endif
$addTextDisplay[-# leaving the game ends ur shift]
$addSelectMenu[aesu:panel_type;shift type]
$addSelectOptions[types;{label};{value};{description};{selected}]
$addButton[yes;aesu:panel_start:$if[$json[selected]==;none;$json[selected;value]];Start;success;$if[$json[selected]==;yes;no]]
$addButton[no;aesu:panel_refresh;Refresh;secondary]
$else
$addTextDisplay[### $json[shift;typeLabel]
$json[shift;statusLabel]]
$addSeparator
$addTextDisplay[started $json[shift;startedRelative]
time: $json[shift;worked]
elapsed: $json[shift;elapsed]
breaks: $json[shift;breaks]
game: $json[shift;game]]
$addTextDisplay[-# shift $json[shift;short]]
$if[$json[state]==on_break]
$addButton[yes;aesu:panel_resume;Resume;success]
$else
$addButton[yes;aesu:panel_break;Break;primary]
$endif
$addButton[no;aesu:panel_end;End shift;danger]
$addButton[no;aesu:panel_refresh;Refresh;secondary]
$endif
$closeContainer
---
@name aesu:panel_type
@type select
$c[Picking a type only arms the Start button. Nothing is recorded until it is pressed.]
$updateMessage
$shiftPanel[$selectedValues]
$include[shiftpanel]
---
@name aesu:panel_start
@type button
$updateMessage
$var[r;$shiftStart[$message[1];panel]]
$onlyIf[$var[r]==ok;$json[error]]
$include[shiftpanel]
---
@name aesu:panel_break
@type button
$updateMessage
$var[r;$shiftBreak]
$onlyIf[$var[r]==ok;$json[error]]
$include[shiftpanel]
---
@name aesu:panel_resume
@type button
$updateMessage
$var[r;$shiftResume]
$onlyIf[$var[r]==ok;$json[error]]
$include[shiftpanel]
---
@name aesu:panel_refresh
@type button
$updateMessage
$shiftPanel
$include[shiftpanel]
---
@name aesu:panel_end
@type button
$updateMessage
$var[r;$shiftEnd]
$onlyIf[$var[r]==ok;$json[error]]
$addContainer[ended]
$addTextDisplay[shift done, $json[worked] banked on ur $json[typeLabel]$if[$json[breakCount]>0;, $json[breakTime] on break]]
$closeContainer
---
@name aesu:prompt_accept
@type button
$c[The "Log this as a shift" button on a join prompt. $message[1] is who the prompt is for.]
$ephemeral
$onlyIf[$message[1]==$authorID;not ur prompt]
$var[r;$shiftPromptAnswer[yes]]
$if[$var[r]==running]
$include[shiftpanel]
$else
$addContainer[pick]
$addTextDisplay[pick what ur running in $if[$json[gameName]==;the game;$json[gameName]], shift starts right away]
$addSelectMenu[aesu:prompt_start;shift type]
$addSelectOptions[types;{label};{value};{description}]
$closeContainer
$endif
---
@name aesu:prompt_decline
@type button
$ephemeral
$onlyIf[$message[1]==$authorID;not ur prompt]
$var[r;$shiftPromptAnswer[no]]
ok nothing logged, `/shift action:manage` if u change ur mind
---
@name aesu:prompt_start
@type select
$c[The menu shown after accepting a join prompt. Picking a type starts the shift straight away.]
$updateMessage
$var[r;$shiftStart[$selectedValues;prompt]]
$onlyIf[$var[r]==ok;$json[error]]
$include[shiftpanel]
---
@name connect
@type slash
@description link ur roblox
@option username:string:ur roblox username
$c[Bloxlink is asked first. If it knows them they only confirm. If they type a username Bloxlink does not vouch for, they prove it with a code in their Roblox About.]
$ephemeral
$var[r;$linkStart[$message[username]]]
$onlyIf[$var[r]!=not_found;$json[error]]
$onlyIf[$var[r]!=ask;$json[error]]
$include[linkcard]
---
@name linkcard
@type snippet
$c[The card from $linkStart. via is bloxlink or code.]
$addContainer[link]
$addSection[### $json[displayName]
@$json[username]
$json[profile];$json[avatar]]
$addSeparator
$if[$json[via]==bloxlink]
$addTextDisplay[this u?]
$addButton[yes;aesu:link_yes;Yep;success]
$else
$addTextDisplay[put this code in ur roblox About, then hit Done
`$json[code]`
u can delete it after]
$addButton[yes;aesu:link_yes;Done;success]
$endif
$addButton[no;aesu:link_no;Cancel;secondary]
$closeContainer
---
@name aesu:link_yes
@type button
$updateMessage
$var[r;$linkConfirm]
$if[$var[r]==missing]
$stop[$json[error]]
$endif
$onlyIf[$var[r]==ok;$json[error]]
$addContainer[link]
$addTextDisplay[linked to $json[displayName] (@$json[username]), u get pinged when u join a tracked game]
$closeContainer
---
@name aesu:link_no
@type button
$updateMessage
$linkCancel
$addContainer[link]
$addTextDisplay[nothing linked, run /connect with ur roblox username]
$closeContainer
---
@name disconnect
@type slash
@description unlink ur roblox
$ephemeral
$var[r;$disconnect]
$onlyIf[$var[r]==ok;$json[error]]
unlinked $json[displayName] (`$json[username]`)$if[$json[closed]==yes;, ur running shift got ended and saved]
shift history stays, `/connect` whenever
---
@name shift log
@type hook
$c[The entry in SHIFT_LOG_CHANNEL_ID. The same message is redrawn as the shift goes on. $json has the shift, see $shiftPanel's shift for the fields.]
$addContainer[log]
$addTextDisplay[### $json[typeLabel]
<@$json[discordId]> · $json[statusLabel]]
$addSeparator
$addTextDisplay[started: $json[started] ($json[startedRelative])
$if[$json[running]==no;ended: $json[ended] ($json[endedRelative]);elapsed: $json[elapsed]]
time: $json[worked]
breaks: $json[breaks]
game: $json[game]
roblox: $json[roblox]]
$if[$json[endReasonLabel]!=]
$addTextDisplay[ended cuz: $json[endReasonLabel]]
$endif
$addTextDisplay[-# shift $json[short] · $json[sourceLabel]]
$closeContainer
---
@name shift auto end
@type hook
$c[DMed when a shift closes itself: they left the game, or it hit MAX_SHIFT_HOURS.]
$addContainer[dm]
$addTextDisplay[ur $json[typeLabel] shift ended, $if[$json[endReason]==left_game;u left $if[$json[gameName]==;the game;$json[gameName]];it went past $json[maxHours]h]
$json[worked] banked$if[$json[breakCount]>0; ($json[breakTime] break)], `/checktime` for totals]
$closeContainer
---
@name shift prompt
@type hook
$c[Posted in SHIFT_PROMPT_CHANNEL_ID when somebody is seen joining a tracked game. Only they get pinged.]
<@$json[discordId]>
$addContainer[prompt]
$addTextDisplay[### on shift?
joined $if[$json[gameName]==;a tracked game;$json[gameName]]$if[$json[robloxUsername]!=; as `$json[robloxUsername]`], log it as a shift?]
$addButton[yes;aesu:prompt_accept:$json[discordId];Log it;success]
$addButton[no;aesu:prompt_decline:$json[discordId];Nah;secondary]
$addTextDisplay[-# only u can press these]
$closeContainer
---
@name shift prompt closed
@type hook
$c[Replaces the join prompt once it is answered or runs out. accepted is yes or no.]
$addContainer[prompt]
$if[$json[accepted]==yes]
$addTextDisplay[### logging it
shift panel opened for $if[$json[gameName]==;the game;$json[gameName]]]
$else
$addTextDisplay[### not logged
no shift for $if[$json[gameName]==;the game;$json[gameName]]]
$endif
$closeContainer
---
@name connect linked
@type hook
$c[DMed once somebody finishes /connect.]
$addContainer[linked]
$addTextDisplay[roblox linked: $json[displayName] (`$json[username]`)
u get pinged when u join a tracked game, or just use `/shift action:manage`]
$closeContainer
