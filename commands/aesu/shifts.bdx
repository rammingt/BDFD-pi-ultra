@name shift
@type slash
@description Manage and review shifts.
@option action:string:What to do.:required:manage=Manage\: Open the shift panel to start, pause or end a shift.|history=History\: List recent shifts.
@option user:user:Whose shifts to list. Defaults to you.
@option limit:integer:How many to show (1 to 25).
$c[Runs the snippet for the action picked, like shift_manage. Each one is below.]
$include[shift_$message[action]]
---
@name shift_manage
@type snippet
$c[/shift action:manage. Open the shift panel to start, pause or end a shift.]
$c[The panel is the "shiftpanel" snippet below, shared by every button on it.]
$ephemeral
$shiftPanel
$include[shiftpanel]
$aesuJoinWarning
---
@name shift_history
@type snippet
$c[/shift action:history. List recent shifts.]
$ephemeral
$var[who;$if[$message[user]==;$authorID;$message[user]]]
$shiftHistory[$var[who];$if[$message[limit]==;10;$message[limit]]]
$addContainer[history]
$addSection[### $displayName[$var[who]]'s recent shifts;$userAvatar[$var[who]]]
$if[$json[count]==0]
$addTextDisplay[No shifts recorded yet.]
$else
$addTextDisplay[$jsonList[shifts;{startedDate} · **{worked}** · {typeLabel}{note}]]
$endif
$closeContainer
$aesuJoinWarning
---
@name checktime
@type slash
@description See how much time has been logged on shift.
@option user:user:Whose time to check. Defaults to you.
@option range:string:Time period to total up. Defaults to all time.::today=Today|week=Last 7 days|month=Last 30 days|all=All time
@option public:boolean:Post the result where everyone can see it.
$if[$message[public]!=true]
$ephemeral
$endif
$var[who;$if[$message[user]==;$authorID;$message[user]]]
$var[r;$shiftTime[$var[who];$message[range]]]
$onlyIf[$var[r]==ok;$json[error]]
$addContainer[time]
$addSection[### $displayName[$var[who]]'s tracked time
$if[$json[linked]==yes;Roblox: $json[roblox];No Roblox account linked] · Range: **$json[rangeLabel]**;$userAvatar[$var[who]]]
$addSeparator
$addTextDisplay[**Total on shift:** $json[worked] ($json[workedHours])
**Shifts:** $json[shiftCount]
**Average:** $json[average]
**Longest:** $json[longest]
**On break:** $json[onBreak]
**Last shift:** $json[lastShift]]
$addSeparator
$addTextDisplay[**Squad:** $json[squad]
**Events hosted:** $json[hostedText]]
$if[$json[byTypeCount]>0]
$addSeparator
$addTextDisplay[**By type**
$jsonList[byType;{label}: {worked} over {shifts}]]
$endif
$if[$json[open]!=]
$addSeparator
$addTextDisplay[**Right now:** $json[open;statusLabel] on a $json[open;typeLabel], $json[open;worked] so far (not counted above).]
$endif
$closeContainer
$aesuJoinWarning
---
@name shiftpanel
@type snippet
$c[Draws the shift panel from $shiftPanel's JSON. state is none, active or on_break.]
$addContainer[panel]
$if[$json[state]==none]
$addTextDisplay[### Shift panel]
$if[$json[selected]!=]
$addTextDisplay[Selected **$json[selected;label]**. $json[selected;description]
Press Start shift when you're ready.]
$else
$addTextDisplay[Pick the kind of shift you are running from the menu below, then press Start shift.]
$endif
$addTextDisplay[-# Your shift ends once you leave the game.]
$addSelectMenu[aesu:panel_type;Select the type of shift]
$addSelectOptions[types;{label};{value};{description};{selected}]
$addButton[yes;aesu:panel_start:$if[$json[selected]==;none;$json[selected;value]];Start shift;success;$if[$json[selected]==;yes;no]]
$addButton[no;aesu:panel_refresh;Refresh;secondary]
$else
$addTextDisplay[### $json[shift;typeLabel]
$json[shift;statusLabel]]
$addSeparator
$addTextDisplay[**Started:** $json[shift;startedRelative]
**Time on shift:** $json[shift;worked]
**Elapsed:** $json[shift;elapsed]
**Breaks:** $json[shift;breaks]
**Game:** $json[shift;game]]
$addTextDisplay[-# Shift $json[shift;short]]
$if[$json[state]==on_break]
$addButton[yes;aesu:panel_resume;Resume shift;success]
$else
$addButton[yes;aesu:panel_break;Take a break;primary]
$endif
$addButton[no;aesu:panel_end;End shift;danger]
$addButton[no;aesu:panel_refresh;Refresh;secondary]
$endif
$closeContainer
---
@name aesu:panel_type
@type select
$c[Picking a type only arms the Start button. Nothing is recorded until it is pressed.]
$updateMessage
$shiftPanel[$selectedValues]
$include[shiftpanel]
---
@name aesu:panel_start
@type button
$updateMessage
$var[r;$shiftStart[$message[1];panel]]
$onlyIf[$var[r]==ok;$json[error]]
$include[shiftpanel]
---
@name aesu:panel_break
@type button
$updateMessage
$var[r;$shiftBreak]
$onlyIf[$var[r]==ok;$json[error]]
$include[shiftpanel]
---
@name aesu:panel_resume
@type button
$updateMessage
$var[r;$shiftResume]
$onlyIf[$var[r]==ok;$json[error]]
$include[shiftpanel]
---
@name aesu:panel_refresh
@type button
$updateMessage
$shiftPanel
$include[shiftpanel]
---
@name aesu:panel_end
@type button
$updateMessage
$var[r;$shiftEnd]
$onlyIf[$var[r]==ok;$json[error]]
$addContainer[ended]
$addTextDisplay[Shift ended. **$json[worked]** banked on your $json[typeLabel]$if[$json[breakCount]>0; and $json[breakTime] on break].]
$closeContainer
---
@name aesu:prompt_accept
@type button
$c[The "Log this as a shift" button on a join prompt. $message[1] is who the prompt is for.]
$ephemeral
$onlyIf[$message[1]==$authorID;That prompt belongs to someone else.]
$var[r;$shiftPromptAnswer[yes]]
$if[$var[r]==running]
$include[shiftpanel]
$else
$addContainer[pick]
$addTextDisplay[Pick what you are running in **$if[$json[gameName]==;the game;$json[gameName]]** and your shift starts right away.]
$addSelectMenu[aesu:prompt_start;Pick a type to start your shift]
$addSelectOptions[types;{label};{value};{description}]
$closeContainer
$endif
---
@name aesu:prompt_decline
@type button
$ephemeral
$onlyIf[$message[1]==$authorID;That prompt belongs to someone else.]
$var[r;$shiftPromptAnswer[no]]
Nothing was logged. Run `/shift action:manage` if you change your mind.
---
@name aesu:prompt_start
@type select
$c[The menu shown after accepting a join prompt. Picking a type starts the shift straight away.]
$updateMessage
$var[r;$shiftStart[$selectedValues;prompt]]
$onlyIf[$var[r]==ok;$json[error]]
$include[shiftpanel]
---
@name connect
@type slash
@description Link your Roblox account so the bot can see when you are in a tracked game.
$ephemeral
$var[r;$connectLink]
$onlyIf[$var[r]==ok;$json[error]]
$addContainer[connect]
$if[$json[linked]==yes]
$addTextDisplay[You are currently linked to **$json[displayName]** (`$json[username]`). Authorising again replaces that link.]
$else
$addTextDisplay[Authorise with Roblox to finish linking your account.]
$endif
$addTextDisplay[The link below is personal and expires in **10 minutes**. Do not share it.
The bot only asks for your basic profile (`openid profile`), it never gets your password.]
$addButton[yes;$json[url];Authorise with Roblox;link]
$closeContainer
---
@name disconnect
@type slash
@description Unlink your Roblox account and stop presence tracking.
$ephemeral
$var[r;$disconnect]
$onlyIf[$var[r]==ok;$json[error]]
Unlinked **$json[displayName]** (`$json[username]`).$if[$json[closed]==yes; Your running shift was ended and saved.]
Your recorded shift history is kept. Run `/connect` again whenever you want.
---
@name shift log
@type hook
$c[The entry in SHIFT_LOG_CHANNEL_ID. The same message is redrawn as the shift goes on. $json has the shift, see $shiftPanel's shift for the fields.]
$addContainer[log]
$addTextDisplay[### $json[typeLabel]
<@$json[discordId]> · $json[statusLabel]]
$addSeparator
$addTextDisplay[**Started:** $json[started] ($json[startedRelative])
$if[$json[running]==no;**Ended:** $json[ended] ($json[endedRelative]);**Elapsed:** $json[elapsed]]
**Time on shift:** $json[worked]
**Breaks:** $json[breaks]
**Game:** $json[game]
**Roblox:** $json[roblox]]
$if[$json[endReasonLabel]!=]
$addTextDisplay[**Closed by:** $json[endReasonLabel]]
$endif
$addTextDisplay[-# Shift $json[short] · from the $json[sourceLabel]]
$closeContainer
---
@name shift auto end
@type hook
$c[DMed when a shift closes itself: they left the game, or it hit MAX_SHIFT_HOURS.]
$addContainer[dm]
$addTextDisplay[Your $json[typeLabel] shift was closed because $if[$json[endReason]==left_game;you left **$if[$json[gameName]==;the game;$json[gameName]]**;it ran past the $json[maxHours] hour limit].
**$json[worked]** was banked$if[$json[breakCount]>0; ($json[breakTime] on break)]. Use `/checktime` to see your totals.]
$closeContainer
---
@name shift prompt
@type hook
$c[Posted in SHIFT_PROMPT_CHANNEL_ID when somebody is seen joining a tracked game. Only they get pinged.]
<@$json[discordId]>
$addContainer[prompt]
$addTextDisplay[### Are you on shift?
You just joined **$if[$json[gameName]==;a tracked game;$json[gameName]]**$if[$json[robloxUsername]!=; as `$json[robloxUsername]`].
Do you want this session logged as a shift?]
$addButton[yes;aesu:prompt_accept:$json[discordId];Log this as a shift;success]
$addButton[no;aesu:prompt_decline:$json[discordId];Not now;secondary]
$addTextDisplay[-# Only you can use these buttons.]
$closeContainer
---
@name shift prompt closed
@type hook
$c[Replaces the join prompt once it is answered or runs out. accepted is yes or no.]
$addContainer[prompt]
$if[$json[accepted]==yes]
$addTextDisplay[### Logging this session
Shift panel opened for **$if[$json[gameName]==;the tracked game;$json[gameName]]**.]
$else
$addTextDisplay[### Not logging this session
No shift was started for **$if[$json[gameName]==;the tracked game;$json[gameName]]**.]
$endif
$closeContainer
---
@name connect linked
@type hook
$c[DMed once somebody finishes /connect.]
$addContainer[linked]
$addTextDisplay[Your Roblox account **$json[displayName]** (`$json[username]`) is linked.
I will ping you when I see you join one of the tracked games so you can log the session as a shift. You can also open the panel any time with `/shift action:manage`.]
$closeContainer
