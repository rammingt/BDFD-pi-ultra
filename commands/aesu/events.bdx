@name event
@type slash
@description events n attendance
@option action:string:what u wanna do:required:create=Create|list=List|info=Info|end=End|cancel=Cancel
@option name:string:event name
@option start:string:when, like now or 90m or 21\:00 or 2026-03-01 21\:00
@option type:string:log time as::from shiftTypes
@option details:string:whats it about
@option image:string:image link for the post
@option roles:string:signup options like Guard\:8, Medic\:2
@option timezone:string:timezone like Asia/Seoul
@option channel:channel:where to post it
@option id:string:event id
$c[Runs the snippet for the action picked, like event_create. Each one is below.]
$include[event_$message[action]]
---
@name event_create
@type snippet
$c[/event action:create. Post a new event people can sign up to.]
$onlyIf[$message[name]!=;fill in name for /event action:create]
$onlyIf[$message[start]!=;fill in start for /event action:create]
$onlyIf[$message[type]!=;fill in type for /event action:create]
$ephemeral
$var[r;$eventCreate[$message[name];$message[start];$message[type];$message[details];$message[image];$message[roles];$message[timezone];$message[channel]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[name] posted in <#$json[channelId]>, starts $json[startsRelative]
id `$json[id]`, runs till someone hits End now, then time gets logged as $json[shiftTypeLabel]
$if[$json[postUrl]!=]
$addButton[yes;$json[postUrl];Go to post;link]
$endif
---
@name event_list
@type snippet
$c[/event action:list. Show events that have not finished yet.]
$ephemeral
$eventList
$onlyIf[$json[count]>0;no events rn, make one with `/event action:create`]
$addContainer[events]
$addTextDisplay[### events
$jsonList[events;`{id}` {name} {startsRelative}{nowNote}]]
$closeContainer
---
@name event_info
@type snippet
$c[/event action:info. Show one event and who signed up.]
$onlyIf[$message[id]!=;fill in id for /event action:info]
$ephemeral
$var[r;$eventInfo[$message[id]]]
$onlyIf[$var[r]==ok;$json[error]]
$include[eventcard]
---
@name event_end
@type snippet
$c[/event action:end. End a running event now and log everybody who attended.]
$onlyIf[$message[id]!=;fill in id for /event action:end]
$ephemeral
$var[r;$eventEnd[$message[id]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[name] ended, time logged for $json[bankedCount]
---
@name event_cancel
@type snippet
$c[/event action:cancel. Call an event off without logging any attendance.]
$onlyIf[$message[id]!=;fill in id for /event action:cancel]
$ephemeral
$var[r;$eventCancel[$message[id]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[name] cancelled, nothing logged
---
@name eventcard
@type snippet
$c[The event itself, from $eventInfo's JSON. Used by the post and by /event action:info.]
$addContainer[event]
$addTextDisplay[## $json[name]]
$if[$json[details]!=]
$addTextDisplay[$json[details]]
$endif
$addTextDisplay[host: $json[host]]
$addSeparator
$addTextDisplay[time: $json[starts] ($json[startsRelative])
ends: $if[$json[ends]==;whenever the host ends it;$json[ends], $json[length] long]
status: $json[statusLabel]]
$addSeparator
$addTextDisplay[$jsonList[roles;{label} ({count})
{list};;\n\n]]
$if[$json[declinedCount]>0]
$addTextDisplay[$json[declinedLabel] ($json[declinedCount])
$json[declinedList]]
$endif
$if[$json[ended]==yes]
$addSeparator
$addTextDisplay[logged as $json[shiftTypeLabel]
$if[$json[bankedCount]==0;nobody was in game long enough;$json[bankedList]]]
$endif
$if[$json[imageUrl]!=]
$addMediaGallery[$json[imageUrl]]
$endif
$addTextDisplay[-# event $json[id]]
$closeContainer
---
@name event post
@type hook
$c[The announcement in EVENT_CHANNEL_ID. It is redrawn on every sign up, so it never pings anybody.]
$include[eventcard]
$if[$json[open]==yes]
$addButtons[roles;aesu:event_join:$json[id]:{key};{label};primary;yes]
$addButton[yes;aesu:event_join:$json[id]:$json[declinedKey];$json[declinedLabel];secondary]
$addButton[no;aesu:event_end:$json[id];End now;secondary]
$addButton[no;aesu:event_cancel:$json[id];Cancel;danger]
$endif
---
@name event start
@type hook
$c[Sent when an event starts. Pings everybody signed up, except those who cannot make it.]
$json[name] starting now $json[mentions]
---
@name event host away
@type hook
$c[Sent once when the host leaves the game while their event is still counting attendance.]
<@$json[hostId]> u left the game but $json[name] is still going, hit End now on $if[$json[url]==;the post;the post ($json[url])] when its over or `/event action:end` with id `$json[id]`
---
@name aesu:event_join
@type button
$c[The sign up buttons on an event post. $message[1] is the event, $message[2] the option.]
$ephemeral
$var[r;$eventSignup[$message[1];$message[2]]]
$onlyIf[$var[r]==ok;$json[error]]
$if[$json[declined]==yes]
ok put u down as $json[label]
$else
signed up as $json[label], ur in game time gets logged when it ends
$endif
---
@name aesu:event_end
@type button
$ephemeral
$var[r;$eventEnd[$message[1]]]
$if[$var[r]==not_started]
$stop[it hasnt started yet, cancel it if its not happening]
$endif
$onlyIf[$var[r]==ok;$json[error]]
$json[name] ended, time logged for $json[bankedCount]
---
@name aesu:event_cancel
@type button
$ephemeral
$var[r;$eventCancel[$message[1]]]
$onlyIf[$var[r]==ok;$json[error]]
$json[name] cancelled
