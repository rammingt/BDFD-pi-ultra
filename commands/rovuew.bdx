@name check
@type slash
@description check a roblox user
@option user:string:roblox username or id:required
@option type:string:what to check, empty = accessories::accessories=Accessories|clothing=Clothing|badges=Badges|full=Full
@option discord:string:their discord id for server sweep n TASE (full only)
$c[Runs check_accessories, check_clothing, check_badges or check_full below.]
$include[check_$if[$message[type]==;accessories;$message[type]]]
---
@name check_accessories
@type snippet
$var[kind;accessories]
$var[title;accessories]
$var[jsonlabel;accessory]
$include[rvsingle]
---
@name check_clothing
@type snippet
$var[kind;clothing]
$var[title;clothing]
$var[jsonlabel;clothing]
$include[rvsingle]
---
@name check_badges
@type snippet
$var[kind;badges]
$var[title;badges]
$var[jsonlabel;badge]
$include[rvsingle]
---
@name rvsingle
@type snippet
$c[Shared by the accessory, clothing and badge checks. Needs kind, title and jsonlabel set first.]
$rvCooldown[chill %time%s before checking again]
$rvCheck[$message[user];$var[kind]]
$onlyIf[$json[status]!=not_found;cant find a roblox user called $message[user]]
$onlyIf[$json[status]!=private;$json[username] inventory is private]
$var[token;$jsonStash]
$addContainer[result]
$addTextDisplay[## $var[title]: $json[username]]
$addSeparator
$addTextDisplay[$if[$json[verdict]==flagged;flagged · score $json[score];$if[$json[verdict]==odd names;nothing flagged but some names look sus (score $json[autoScore]);clean]]
$if[$json[scanIncomplete]==yes;scan didnt finish: $json[scanError];scanned $json[scanned] $json[noun], $json[matchCount] flagged]]
$if[$json[matchCount]>0]
$addSeparator
$addTextDisplay[### flagged · score $json[score]
$jsonList[matches;• [{name}]({url}) · score {score} · {reason};15;;• +{n} more in the JSON]]
$endif
$if[$json[autoCount]>0]
$addSeparator
$addTextDisplay[### sus names · score $json[autoScore]
$jsonList[auto;• [{name}]({url}) · {score} · {reasons};10;;• +{n} more in the JSON]
-# $json[autoNote]]
$endif
$addTextDisplay[-# roblox id $json[userId]]
$closeContainer
$addButton[no;rvjson:$var[token];Full $var[jsonlabel] list (JSON);secondary]
---
@name check_full
@type snippet
$rvCooldown[chill %time%s before checking again]
$rvCheck[$message[user];full;$message[discord]]
$onlyIf[$json[status]!=not_found;cant find a roblox user called $message[user]]
$var[token;$jsonStash]
$addContainer[result]
$addTextDisplay[## full check: $json[username]]
$addSeparator
$addTextDisplay[$if[$json[verdict]==flagged;flagged · score $json[totalScore];$if[$json[verdict]==odd names;nothing flagged but some names look sus (score $json[autoScore]);$if[$json[verdict]==incomplete;nothing found but a source didnt answer, so not fully clear;clean everywhere]]]]
$addTextDisplay[accessories: $json[accessories]
clothing: $json[clothing]
badges: $json[badges]]
$if[$json[matchCount]>0]
$addSeparator
$addTextDisplay[### flagged ($json[matchCount], score $json[totalScore])
$jsonList[matches;• [{name}]({url}) · score {score} · {reason};10;;• +{n} more in the JSON]]
$endif
$if[$json[autoCount]>0]
$addSeparator
$addTextDisplay[### sus names ($json[autoCount], score $json[autoScore])
$jsonList[auto;• [{name}]({url}) · {score} · {reasons};8;;• +{n} more in the JSON]
-# $json[autoNote]]
$endif
$addSeparator
$addTextDisplay[$jsonList[providers;{name}
{text};5;

]]
$if[$json[appealsUrl]!=]
$addTextDisplay[appeals: if u mod someone over this, send them to $json[appealsUrl]]
$endif
$addTextDisplay[-# roblox id $json[userId]$if[$message[discord]!=; · discord id $message[discord]]]
$closeContainer
$addButton[no;rvjson:$var[token];Full list (JSON);secondary]
---
@name rvjson
@type button
$c[The "View full list (JSON)" buttons. Only the person who ran the command can use theirs, for 15 minutes. The file goes to their DMs, since phones often can't open files in "only you can see this" replies.]
$ephemeral
$var[state;$jsonUnstash[$message[1];yes]]
$onlyIf[$var[state]!=expired;expired, run it again]
$onlyIf[$var[state]!=notyours;not ur button, run it urself]
$dm
$attachFile[$json[filename];$jsonPretty[file]]
full list
---
@name searchcatalog
@type slash
@description search the catalog n flag stuff
@option keyword:string:search for:required
@option category:string:where to search, empty = both::accessory=Accessories|clothing=Clothing|classicshirt=Classic shirts|classicpants=Classic pants|both=Both
@option pages:integer:pages of 30 (1 to 5)
@option reason:string:reason for anything u add
@option score:integer:score for anything u add (default 1)
$ephemeral
$onlyIf[$rvIsAdmin==true;need manage server or the admin role for this]
$rvCooldown[chill %time%s before searching again]
$rvSearch[$message[keyword];$message[category];$message[pages]]
$jsonSet[reason;$message[reason]]
$jsonSet[score;$message[score]]
$var[token;$jsonStash]
$addContainer[search]
$addTextDisplay[## catalog search]
$addSeparator
$addTextDisplay[$json[count] $json[categoryLabel] for `$json[keyword]`$if[$message[reason]!=;
added stuff gets: $message[reason] (score $if[$message[score]!=;$message[score];1])]$if[$json[hasErrors]==yes;
didnt finish: $json[errors]]]
$if[$json[count]==0]
$addTextDisplay[nothing in $json[categoryLabel]]
$else
$addTextDisplay[$jsonList[results;`{n}` [{name}]({url}) · {assetTypeName} · `{assetId}`{note};30;;+{n} more in the JSON]]
$if[$json[allFlagged]==yes]
$addTextDisplay[-# all of these r flagged already]
$else
$addSelectMenu[rvsearchadd:$var[token];pick stuff to flag ($json[addableCount]);1;25]
$addSelectOptions[addable;{name};{assetId};{assetTypeName} · ID {assetId}]
$addTextDisplay[-# $if[$json[addableCount]>25;menu only fits 25, search something narrower for the rest;pick as many as u want]]
$endif
$endif
$closeContainer
$addButton[no;rvjson:$var[token];Full list (JSON);secondary]
---
@name rvsearchadd
@type select
$c[The menu under /searchcatalog. Adds the picked items to the flagged list and leaves the menu usable for more.]
$ephemeral
$var[state;$jsonUnstash[$message[1];yes]]
$onlyIf[$var[state]!=expired;search expired, run /searchcatalog again]
$onlyIf[$var[state]!=notyours;not ur search]
$onlyIf[$rvIsAdmin==true;need manage server or the admin role for this]
$rvSearchAdd[$selectedValues[,]]
flagged $json[addedCount]
$jsonList[added;• {name} · {type} · ID {assetId} · score {score}]
$if[$json[skipped]>0;skipped $json[skipped], already flagged;]
---
@name resolvelink
@type slash
@description share link to item
@option link:string:share link or code:required
$rvCooldown[chill %time%s before trying again]
$rvResolveLink[$message[link]]
$onlyIf[$json[status]!=invalid_link;thats not a share link or code, paste the whole link or just the code]
$onlyIf[$json[status]!=not_found;roblox cant find an item for that link, might be expired or not an item link$if[$json[detail]!=;
`$json[detail]`]]
$var[token;$jsonStash]
$addContainer[link]
$addTextDisplay[## share link]
$addSeparator
$addTextDisplay[<$json[url]>
name: $if[$json[name]!=;$json[name];idk (id $json[assetId])]
asset id: `$json[assetId]`
category: $if[$json[assetTypeName]!=;$json[assetTypeName] ($json[type]);idk]]
$if[$json[name]==]
$addTextDisplay[-# got the id but the catalog lookup for the name failed]
$endif
$closeContainer
$addButton[no;rvjson:$var[token];Full item (JSON);secondary]
---
@name autoflag
@type slash
@description sus name keywords
@option action:string:what u wanna do:required:add=Add|remove=Remove|list=List
@option keyword:string:word or phrase
@option reason:string:what kind::nsfw=NSFW|political=Political|inappropriate=Inappropriate
@option score:integer:score (0 to 100)
$c[Runs the snippet for the action picked, like autoflag_add. Each one is below.]
$include[autoflag_$message[action]]
---
@name autoflag_add
@type snippet
$c[/autoflag action:add. Add a keyword that item names are automatically scanned for]
$onlyIf[$message[keyword]!=;fill in keyword for /autoflag action:add]
$onlyIf[$message[reason]!=;fill in reason for /autoflag action:add]
$onlyIf[$message[score]!=;fill in score for /autoflag action:add]
$onlyIf[$rvIsAdmin==true;need manage server or the admin role for this]
$rvKeywordAdd[$message[keyword];$message[reason];$message[score]]
$onlyIf[$json[status]!=problem;that keyword wont work: $json[problem]]
$onlyIf[$json[status]!=covered;$if[$json[covered;custom]==yes;already covered by `$json[covered;term]` (score $json[covered;score]), remove that first to change it;the built in list already catches that as "$json[covered;reason]" (score $json[covered;score]), nothing added]]
added `$json[keyword;keyword]`
$json[label] · score $json[keyword;score]
$json[how]
-# $json[autoNote]
---
@name autoflag_remove
@type snippet
$c[/autoflag action:remove. Remove a keyword from the automatic name scan]
$onlyIf[$message[keyword]!=;fill in keyword for /autoflag action:remove]
$onlyIf[$rvIsAdmin==true;need manage server or the admin role for this]
$rvKeywordRemove[$message[keyword]]
$onlyIf[$json[removed]==yes;no keyword like that]
removed `$json[keyword;keyword]`
---
@name autoflag_list
@type snippet
$c[/autoflag action:list. List the custom automatic keywords]
$onlyIf[$rvIsAdmin==true;need manage server or the admin role for this]
$rvKeywords
$onlyIf[$json[count]>0;no custom keywords yet, the built in list still runs]
$addContainer[keywords]
$addTextDisplay[## keywords]
$addSeparator
$addTextDisplay[$jsonList[keywords;• `{keyword}` · score {score} · {label};40]]
$addTextDisplay[-# $json[count] custom, plus the built in list · $json[autoNote]]
---
@name flag
@type slash
@description flagged items
@option action:string:what u wanna do:required:add=Add|remove=Remove|list=List
@option id:string:badge or asset id
@option name:string:name, empty = auto
@option type:string:type, empty = auto::badge=Badge|accessory=Accessory|clothing=Clothing
@option reason:string:why
@option score:integer:score (default 1)
@option link:string:catalog or badge link
$c[Runs the snippet for the action picked, like flag_add. Each one is below.]
$include[flag_$message[action]]
---
@name flag_add
@type snippet
$c[/flag action:add. Add a badge, accessory, or clothing item to the flagged list]
$onlyIf[$message[id]!=;fill in id for /flag action:add]
$onlyIf[$rvIsAdmin==true;need manage server or the admin role for this]
$onlyIf[$isNumber[$message[id]]==true;id has to be just a number, the badge or asset id from the link]
$rvFlagAdd[$message[id];$message[name];$message[type];$message[reason];$message[score];$message[link]]
$onlyIf[$json[status]!=not_found;nothing on roblox with id $message[id], check it]
$onlyIf[$json[status]!=unverified;cant tell what $message[id] is (roblox blocks badge lookups now), run it again with type set, and name too if its a badge]
$onlyIf[$json[status]!=exists;$json[flag;name] is already flagged
$json[flag;type] · ID $json[flag;assetId] · score $json[flag;score]
reason: $json[flag;reason]
/flag action:remove it first to change it]
flagged $json[flag;name]
$json[flag;type] · ID $json[flag;assetId] · score $json[flag;score]
reason: $json[flag;reason]
$if[$json[placeholderName]==true;couldnt get a name from roblox so its a placeholder, add it again with name set if u want;]
---
@name flag_remove
@type snippet
$c[/flag action:remove. Remove an item from the flagged list]
$onlyIf[$message[name]!=;fill in name for /flag action:remove]
$onlyIf[$rvIsAdmin==true;need manage server or the admin role for this]
$rvFlagRemove[$message[name]]
$onlyIf[$json[removed]==yes;no flag like $message[name]]
unflagged $json[flag;name]
---
@name flag_list
@type snippet
$c[/flag action:list. List all currently flagged items]
$rvFlags
$onlyIf[$json[count]>0;nothing flagged rn]
$addContainer[flags]
$addTextDisplay[## flagged]
$addSeparator
$addTextDisplay[$jsonList[flags;• [{name}]({url}) · score {score} · {type} · `{assetId}`
  {reason};25]]
$addTextDisplay[-# $json[count] flags, total score $json[totalScore]$if[$json[count]>25; · top 25 only]]
$closeContainer
$addButton[no;rvflagsjson;Full list (JSON);secondary]
---
@name rvflagsjson
@type button
$c[Always sends a fresh copy of the flag list, since it can change after /flag action:list ran.]
$ephemeral
$rvFlags
$dm
$attachFile[$json[filename];$jsonPretty[file]]
full flagged list
